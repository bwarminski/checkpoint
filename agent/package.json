{
  "name": "checkpoint-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:code-search-server": "tsx src/mcp-servers/code-search/main.ts",
    "test": "node --import tsx --test test/*.test.ts test/e2e/*.test.ts",
    "generate:code-search": "bun ./node_modules/mcporter/dist/cli.js emit-ts code-search --config .mcporter.json --mode client --out src/tools/generated/code-search-client.ts && bun scripts/fix-generated-code-search-client.mjs",
    "pretypecheck": "npm run generate:code-search",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run generate:code-search",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "mcporter": "^0.8.1",
    "tsx": "4.21.0",
    "typescript": "^6.0.2"
  }
}
